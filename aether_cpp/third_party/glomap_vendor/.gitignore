# On-device GLOMAP/COLMAP SfM research — ignore build artifacts & large binaries.

# Xcode derived data / build output (xcodegen `dd/` + DerivedData)
dd/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# iOS C++ build tree (cmake) — regenerated by the build scripts
build-ios/
build-desktop/
build/

# build logs
*.log

# large regenerable SfM bench databases (~20MB each) — rebuild via build_db50.sh
*.db

# macOS
.DS_Store
